{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cmake: configure",
			"type": "cmake",
			"command": "configure",
			"problemMatcher": []
		},
		{
			"label": "cmake: build",
			"type": "cmake",
			"command": "build",
			"targets": [
				"all"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc",
			"detail": "Builds every target of the selected CMake preset (Ninja has no ALL_BUILD)"
		},
		{
			"label": "cmake: clean",
			"type": "cmake",
			"command": "clean",
			"problemMatcher": []
		},
		{
			"label": "run: demo",
			"type": "shell",
			"command": "${workspaceFolder}/build/bin/Release/demo",
			"dependsOn": "cmake: build",
			"problemMatcher": [],
			"detail": "Assets are copied next to the executable, so the working directory does not matter"
		},
		{
			"label": "test: ctest (build/)",
			"type": "shell",
			"command": "ctest",
			"args": [
				"--test-dir",
				"build",
				"--output-on-failure"
			],
			"dependsOn": "cmake: build",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}